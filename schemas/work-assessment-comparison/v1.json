{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gca.local/schemas/work-assessment-comparison/v1.json",
  "type": "object",
  "required": ["schemaVersion", "reportType", "baseRunId", "targetRunId", "baseSnapshotId", "targetSnapshotId", "changes", "sizeDistributionChanges", "difficultyDistributionChanges", "subjects", "warnings", "comparable", "limitations"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "reportType": { "const": "WORK_ASSESSMENT_COMPARISON" },
    "baseRunId": { "type": "string" },
    "targetRunId": { "type": "string" },
    "baseSnapshotId": { "type": ["string", "null"] },
    "targetSnapshotId": { "type": ["string", "null"] },
    "changes": { "$ref": "#/$defs/changeSet" },
    "sizeDistributionChanges": { "type": "object", "additionalProperties": { "type": "integer" } },
    "difficultyDistributionChanges": { "type": "object", "additionalProperties": { "type": "integer" } },
    "subjects": { "type": "array", "items": { "type": "object" } },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "comparable": { "type": "boolean" },
    "limitations": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "change": {
      "type": "object",
      "required": ["absolute", "percent"],
      "properties": {
        "absolute": { "type": "integer" },
        "percent": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "changeSet": { "type": "object", "additionalProperties": { "$ref": "#/$defs/change" } }
  },
  "additionalProperties": false
}
