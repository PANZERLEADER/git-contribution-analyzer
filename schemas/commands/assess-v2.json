{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gca.local/schemas/commands/assess-v2.json",
  "type": "object",
  "required": ["schemaVersion", "command", "success", "data", "warnings", "error"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "command": { "const": "assess" },
    "success": { "const": true },
    "data": {
      "type": "object",
      "required": ["schemaVersion", "reportType"],
      "properties": {
        "schemaVersion": { "const": "2.0" },
        "reportType": { "const": "WORK_ASSESSMENT" }
      }
    },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "error": { "type": "null" }
  },
  "additionalProperties": false
}
