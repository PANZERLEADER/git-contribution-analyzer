{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gca.local/schemas/commands/structural-prune-v1.json",
  "type": "object",
  "required": ["schemaVersion", "command", "success", "data", "warnings", "error"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "command": { "const": "structural prune" },
    "success": { "const": true },
    "data": {
      "type": "object",
      "required": ["deletedBaselines", "remainingBaselines"],
      "properties": {
        "deletedBaselines": { "type": "integer", "minimum": 0 },
        "remainingBaselines": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "error": { "type": "null" }
  },
  "additionalProperties": false
}
