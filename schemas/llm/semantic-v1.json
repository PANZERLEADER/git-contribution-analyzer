{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gca.local/schemas/llm/semantic-v1.json",
  "type": "object",
  "required": [
    "overallSummary",
    "contributionSummaries",
    "capabilityExplanations",
    "resumeBullets"
  ],
  "properties": {
    "overallSummary": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/claim" }
    },
    "contributionSummaries": {
      "type": "array",
      "items": { "$ref": "#/$defs/contributionSummary" }
    },
    "capabilityExplanations": {
      "type": "array",
      "items": { "$ref": "#/$defs/capabilityExplanation" }
    },
    "resumeBullets": {
      "deprecated": true,
      "$comment": "Use the independent resume-v1 task and gca resume command.",
      "type": "array",
      "items": { "$ref": "#/$defs/claim" }
    }
  },
  "$defs": {
    "claim": {
      "type": "object",
      "required": ["text", "evidenceIds", "confidence"],
      "properties": {
        "text": { "type": "string", "minLength": 1 },
        "evidenceIds": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "confidence": { "enum": ["HIGH", "MEDIUM", "LOW"] }
      },
      "additionalProperties": false
    },
    "contributionSummary": {
      "type": "object",
      "required": ["text", "evidenceIds", "confidence", "contributionItemId"],
      "properties": {
        "text": { "type": "string", "minLength": 1 },
        "evidenceIds": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "confidence": { "enum": ["HIGH", "MEDIUM", "LOW"] },
        "contributionItemId": { "type": "string" }
      },
      "additionalProperties": false
    },
    "capabilityExplanation": {
      "type": "object",
      "required": ["text", "evidenceIds", "confidence", "capability"],
      "properties": {
        "text": { "type": "string", "minLength": 1 },
        "evidenceIds": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "confidence": { "enum": ["HIGH", "MEDIUM", "LOW"] },
        "capability": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
