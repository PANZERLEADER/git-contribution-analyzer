# Repository-local configuration references these environment variables by name.
# Never put real credentials in tracked files.
GCA_LLM_BASE_URL=https://example.invalid/v1
GCA_LLM_API_KEY=replace-me
GCA_LLM_PROVIDER=openai-compatible
GCA_LLM_MODEL=replace-with-model-id
GCA_LLM_EXECUTABLE=replace-with-optional-cli-path
